/* theme_dark.qss — Sistema Clínico (Tema Oscuro: Nocturno Clínico Descansado) */

QWidget {
    color: #e2e8f0;
    font-family: "Segoe UI Variable", "Segoe UI", "Inter", sans-serif;
    font-size: 13.5px;
}

QMainWindow, QDialog, QWidget#dashboardMain, QWidget#homeWidget, QScrollArea, QStackedWidget {
    background-color: #0b1316;
    color: #e2e8f0;
}

QLabel {
    background: transparent;
    border: none;
    color: #e2e8f0;
}

QWidget#loginBackground {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0b1316, stop:1 #132227);
}

/* Tarjetas y Contenedores */
#formContainer, QFrame#card, QFrame#rightPanel, QFrame#kpiCard {
    background-color: #131f24;
    border-radius: 12px;
    border: 1px solid #22353d;
}

QFrame#subCard, QFrame#filterBox {
    background-color: #0f191d;
    border-radius: 10px;
    border: 1px solid #22353d;
}

QFrame#infoBanner {
    background-color: #102a38;
    border: 1px solid #1e4b63;
    border-radius: 8px;
}

QLabel#titleLabel {
    font-size: 28px;
    font-weight: 800;
    color: #f8fafc;
}

QLabel#subtitleLabel {
    color: #94a3b8;
    font-size: 14px;
}

/* Campos de Entrada */
QLineEdit, QTextEdit, QDoubleSpinBox, QSpinBox, QDateEdit, QTimeEdit, QComboBox, QLineEdit#smartDateInput {
    background-color: #0b1316;
    border: 1.5px solid #2a4049;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13.5px;
    color: #f1f5f9;
}

QComboBox {
    padding: 5px 10px;
    min-height: 26px;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView, QComboBox QListView {
    background-color: #131f24;
    color: #f1f5f9;
    border: 1px solid #2a4049;
    border-radius: 8px;
    selection-background-color: #1e4b63;
    selection-color: #ffffff;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item, QComboBox QListView::item {
    min-height: 26px;
    padding: 4px 8px;
    color: #f1f5f9;
    background-color: #131f24;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected,
QComboBox QListView::item:hover,
QComboBox QListView::item:selected {
    background-color: #1e4b63;
    color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus,
QDateEdit:focus, QTimeEdit:focus, QComboBox:focus, QLineEdit#smartDateInput:focus {
    border: 1.5px solid #2dd4bf;
    background-color: #131f24;
}

/* Botones Globales */
QPushButton#primaryButton, QPushButton#btnPrimary {
    background-color: #2a72de;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: bold;
    padding: 8px 18px;
}
QPushButton#primaryButton:hover, QPushButton#btnPrimary:hover { background-color: #3b82f6; }

QPushButton#btnSuccess {
    background-color: #0d332d;
    color: #34d399;
    border: 1px solid #065f46;
    border-radius: 8px;
    font-size: 13px;
    font-weight: bold;
    padding: 8px 16px;
}
QPushButton#btnSuccess:hover { background-color: #064e3b; }

QPushButton#btnSecondary, QPushButton#btnPdf, QPushButton#btnWarning, QPushButton#smartDateBtn {
    background-color: #192930;
    color: #e2e8f0;
    border: 1px solid #2a4049;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    padding: 7px 14px;
}
QPushButton#btnSecondary:hover, QPushButton#btnPdf:hover, QPushButton#btnWarning:hover, QPushButton#smartDateBtn:hover {
    background-color: #223842;
}

QPushButton#btnDanger {
    background-color: #3b1219;
    color: #fca5a5;
    border: 1px solid #7f1d1d;
    border-radius: 8px;
    font-size: 13px;
    font-weight: bold;
    padding: 7px 14px;
}
QPushButton#btnDanger:hover { background-color: #7f1d1d; color: #ffffff; }

QPushButton#logoutBtn {
    background-color: #3b1219;
    color: #fca5a5;
    border: 1px solid #7f1d1d;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 12px;
}
QPushButton#logoutBtn:hover { background-color: #dc2626; color: #ffffff; }

/* Checkboxes */
QCheckBox {
    color: #e2e8f0;
    font-size: 13px;
    font-weight: 600;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1.5px solid #2a4049;
    background-color: #0b1316;
}
QCheckBox::indicator:checked {
    background-color: #2dd4bf;
    border-color: #2dd4bf;
}

/* Topbar & Sidebar */
QFrame#topbar {
    background-color: #131f24;
    border-bottom: 1px solid #22353d;
}
QLabel#topbarTitle {
    color: #f8fafc;
    font-weight: 700;
    font-size: 15px;
}
QFrame#sidebar {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #0d1d21, stop:1 #071215);
    border-right: 1px solid #1a2f35;
}

/* Tablas */
QTableWidget {
    background-color: #131f24;
    border: 1px solid #22353d;
    border-radius: 10px;
    gridline-color: transparent;
    font-size: 13px;
    alternate-background-color: #0f191d;
    color: #e2e8f0;
}
QHeaderView::section {
    background-color: #192930;
    color: #cbd5e1;
    font-weight: bold;
    border: none;
    padding: 8px 10px;
    border-bottom: 2px solid #2a4049;
}
QTableWidget::item { padding: 6px 8px; color: #e2e8f0; }
QTableWidget::item:selected {
    background-color: #1e4b63;
    color: #ffffff;
}

/* Pestañas */
QTabWidget::pane {
    border: 1px solid #22353d;
    border-radius: 10px;
    background-color: #131f24;
    top: -1px;
}
QTabBar::tab {
    background-color: #0f191d;
    color: #94a3b8;
    padding: 9px 18px;
    margin-right: 3px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
    font-size: 13px;
}
QTabBar::tab:selected {
    background-color: #131f24;
    color: #2dd4bf;
    border: 1px solid #22353d;
    border-bottom: 2px solid #131f24;
}
QTabBar::tab:hover:!selected {
    background-color: #192930;
    color: #f8fafc;
}

/* Barra de Menú */
QMenuBar {
    background-color: #131f24;
    border-bottom: 1px solid #22353d;
    padding: 2px 4px;
    font-size: 13px;
    color: #e2e8f0;
}
QMenuBar::item { background: transparent; padding: 6px 14px; border-radius: 5px; }
QMenuBar::item:selected { background: #192930; color: #2dd4bf; }
QMenu {
    background-color: #131f24;
    border: 1px solid #2a4049;
    border-radius: 8px;
    padding: 6px 0px;
    color: #e2e8f0;
}
QMenu::item { padding: 7px 28px 7px 16px; border-radius: 4px; margin: 1px 4px; }
QMenu::item:selected { background: #1e4b63; color: #ffffff; }
