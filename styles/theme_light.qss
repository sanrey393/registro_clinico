/* theme_light.qss — Sistema Clínico (Tema Claro: Oura + Linear) */

QWidget {
    color: #1e293b;
    font-family: "Segoe UI Variable", "Segoe UI", "Inter", sans-serif;
    font-size: 13.5px;
}

QMainWindow, QDialog, QWidget#dashboardMain, QWidget#homeWidget, QScrollArea, QStackedWidget {
    background-color: #f6f7f5;
    color: #1e293b;
}

QLabel {
    background: transparent;
    border: none;
    color: #1e293b;
}

QWidget#loginBackground {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #eef2f6, stop:1 #e0ecea);
}

/* Tarjetas y Contenedores */
#formContainer, QFrame#card, QFrame#rightPanel, QFrame#kpiCard {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
}

QFrame#subCard, QFrame#filterBox {
    background-color: #f8fafc;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
}

QFrame#infoBanner {
    background-color: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 8px;
}

QLabel#titleLabel {
    font-size: 28px;
    font-weight: 800;
    color: #0f172a;
}

QLabel#subtitleLabel {
    color: #64748b;
    font-size: 14px;
}

/* Campos de Entrada */
QLineEdit, QTextEdit, QDoubleSpinBox, QSpinBox, QDateEdit, QTimeEdit, QComboBox, QLineEdit#smartDateInput {
    background-color: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13.5px;
    color: #0f172a;
}

QComboBox {
    padding: 5px 10px;
    min-height: 26px;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView, QComboBox QListView {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    selection-background-color: #e0f2fe;
    selection-color: #0369a1;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item, QComboBox QListView::item {
    min-height: 26px;
    padding: 4px 8px;
    color: #0f172a;
    background-color: #ffffff;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected,
QComboBox QListView::item:hover,
QComboBox QListView::item:selected {
    background-color: #e0f2fe;
    color: #0369a1;
}

QLineEdit:focus, QTextEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus,
QDateEdit:focus, QTimeEdit:focus, QComboBox:focus, QLineEdit#smartDateInput:focus {
    border: 1.5px solid #2a72de;
    background-color: #ffffff;
}

/* Botones Globales */
QPushButton#primaryButton, QPushButton#btnPrimary {
    background-color: #2a72de;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: bold;
    padding: 8px 18px;
}
QPushButton#primaryButton:hover, QPushButton#btnPrimary:hover { background-color: #1d5ec2; }

QPushButton#btnSuccess {
    background-color: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
    border-radius: 8px;
    font-size: 13px;
    font-weight: bold;
    padding: 8px 16px;
}
QPushButton#btnSuccess:hover { background-color: #d1fae5; }

QPushButton#btnSecondary, QPushButton#btnPdf, QPushButton#btnWarning, QPushButton#smartDateBtn {
    background-color: #f8fafc;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    padding: 7px 14px;
}
QPushButton#btnSecondary:hover, QPushButton#btnPdf:hover, QPushButton#btnWarning:hover, QPushButton#smartDateBtn:hover {
    background-color: #e2e8f0;
}

QPushButton#btnDanger {
    background-color: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
    border-radius: 8px;
    font-size: 13px;
    font-weight: bold;
    padding: 7px 14px;
}
QPushButton#btnDanger:hover { background-color: #fee2e2; }

QPushButton#logoutBtn {
    background-color: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 12px;
}
QPushButton#logoutBtn:hover { background-color: #dc2626; color: #ffffff; }

/* Checkboxes */
QCheckBox {
    color: #1e293b;
    font-size: 13px;
    font-weight: 600;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1.5px solid #cbd5e1;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    background-color: #2a72de;
    border-color: #2a72de;
}

/* Topbar & Sidebar */
QFrame#topbar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}
QLabel#topbarTitle {
    color: #0f172a;
    font-weight: 700;
    font-size: 15px;
}
QFrame#sidebar {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #132a2e, stop:1 #0d1f22);
    border-right: 1px solid #1e3a3f;
}

/* Tablas */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    gridline-color: transparent;
    font-size: 13px;
    alternate-background-color: #f8fafc;
    color: #0f172a;
}
QHeaderView::section {
    background-color: #f1f5f9;
    color: #475569;
    font-weight: bold;
    border: none;
    padding: 8px 10px;
    border-bottom: 2px solid #cbd5e1;
}
QTableWidget::item { padding: 6px 8px; }
QTableWidget::item:selected {
    background-color: #dbeafe;
    color: #1e40af;
}

/* Pestañas */
QTabWidget::pane {
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background-color: #ffffff;
    top: -1px;
}
QTabBar::tab {
    background-color: #f1f5f9;
    color: #64748b;
    padding: 9px 18px;
    margin-right: 3px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
    font-size: 13px;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #2a72de;
    border: 1px solid #e2e8f0;
    border-bottom: 2px solid #ffffff;
}
QTabBar::tab:hover:!selected {
    background-color: #e2e8f0;
    color: #0f172a;
}

/* Barra de Menú */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 2px 4px;
    font-size: 13px;
    color: #1e293b;
}
QMenuBar::item { background: transparent; padding: 6px 14px; border-radius: 5px; }
QMenuBar::item:selected { background: #eff6ff; color: #2a72de; }
QMenu {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px 0px;
    color: #1e293b;
}
QMenu::item { padding: 7px 28px 7px 16px; border-radius: 4px; margin: 1px 4px; }
QMenu::item:selected { background: #eff6ff; color: #2a72de; }
