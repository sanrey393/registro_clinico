rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(resource) {
      // El documento pertenece al usuario si coincide el user_id,
      // o si el documento no tiene user_id (retrocompatibilidad).
      return isAuthenticated() && (
        !("user_id" in resource.data) ||
        resource.data.user_id == "" ||
        resource.data.user_id == request.auth.uid
      );
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // ── Usuarios ──────────────────────────────────────────────
    match /usuarios/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // ── Pacientes ─────────────────────────────────────────────
    match /pacientes/{pacienteId} {
      allow read:   if isAuthenticated() && isOwner(resource);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource);
      allow delete: if isAuthenticated() && isOwner(resource);
    }

    // ── Historias Clínicas ────────────────────────────────────
    match /historias_clinicas/{historiaId} {
      allow read:   if isAuthenticated() && isOwner(resource);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource);
      allow delete: if isAuthenticated() && isOwner(resource);
    }

    // ── Sesiones Clínicas ─────────────────────────────────────
    match /sesiones/{sesionId} {
      allow read:   if isAuthenticated() && isOwner(resource);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource);
      allow delete: if isAuthenticated() && isOwner(resource);
    }

    // Alias de retrocompatibilidad
    match /sesiones_clinicas/{sesionId} {
      allow read:   if isAuthenticated() && isOwner(resource);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource);
      allow delete: if isAuthenticated() && isOwner(resource);
    }

    // ── Prescripciones / Recetas ──────────────────────────────
    match /recetas/{recetaId} {
      allow read:   if isAuthenticated() && isOwner(resource);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource);
      allow delete: if isAuthenticated() && isOwner(resource);
    }

    match /prescripciones/{prescripcionId} {
      allow read:   if isAuthenticated() && isOwner(resource);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource);
      allow delete: if isAuthenticated() && isOwner(resource);
    }

    // ── Citas ─────────────────────────────────────────────────
    match /citas/{citaId} {
      allow read:   if isAuthenticated() && isOwner(resource);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource);
      allow delete: if isAuthenticated() && isOwner(resource);
    }

    // ── Facturación ───────────────────────────────────────────
    match /facturas/{facturaId} {
      allow read:   if isAuthenticated() && isOwner(resource);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource);
      allow delete: if isAuthenticated() && isOwner(resource);
    }

    // ── Fármacos ──────────────────────────────────────────────
    // Los fármacos del catálogo global (is_global=true) son visibles para todos
    // Los fármacos registrados por el médico solo los ve él
    match /farmacos/{farmacoId} {
      allow read:   if isAuthenticated() && (
        resource.data.get("is_global", false) == true ||
        isOwner(resource)
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isOwner(resource) || isAdmin());
      allow delete: if isAuthenticated() && (isOwner(resource) || isAdmin());
    }

    // ── Sistema / Actualizaciones ─────────────────────────────
    match /sistema/actualizacion {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Catálogos Diagnósticos ────────────────────────────────
    match /diagnosticos_catalogo/{diagId} {
      allow read:   if isAuthenticated() && (
        resource.data.get("is_global", false) == true ||
        isOwner(resource)
      );
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && (isOwner(resource) || isAdmin());
    }

    // ── Licencias de Equipo ───────────────────────────────────
    match /licencias/{machineId} {
      allow read, create, update: if isAuthenticated();
    }
  }
}
